#!/bin/bash

STEP_VERSION="0.30.6"

if ! type -t require_step >/dev/null 2>&1; then
require_step() {
  local tool="step@${STEP_VERSION}"
  local bin_dir

  if command -v step >/dev/null 2>&1; then
    return 0
  fi

  require_mise_tool "$tool"
  bin_dir=$(mise bin-paths "$tool") || die "mise installed ${tool} but did not report its bin path"
  export PATH="${bin_dir}:$PATH"

  command -v step >/dev/null 2>&1 \
    || die "step was installed with mise but is still not in PATH"
}
fi

if ! type -t github_app_field >/dev/null 2>&1; then
github_app_field() {
  local entry="$1" field="$2" pair
  local -a pairs

  IFS=',' read -r -a pairs <<< "$entry"
  for pair in "${pairs[@]}"; do
    case "$pair" in
      "${field}="*) echo "${pair#*=}"; return 0 ;;
    esac
  done
}
fi

if ! type -t github_app_entry >/dev/null 2>&1; then
github_app_entry() {
  local org="$1" wanted entry entry_org configured=""
  local -a entries

  if [ -z "${NP_GITHUB_APPS:-}" ]; then
    die "NP_GITHUB_APPS is not set on the agent: configure a GitHub App for '${org}' in the agent's github.apps"
  fi

  wanted=$(printf '%s' "$org" | tr '[:upper:]' '[:lower:]')
  IFS=';' read -r -a entries <<< "$NP_GITHUB_APPS"

  for entry in "${entries[@]}"; do
    entry_org=$(github_app_field "$entry" org | tr '[:upper:]' '[:lower:]')
    if [ "$entry_org" = "$wanted" ]; then
      echo "$entry"
      return 0
    fi
    configured="${configured:+${configured}, }${entry_org}"
  done

  die "no GitHub App configured for org '${org}' in the agent's NP_GITHUB_APPS (configured: ${configured:-none})"
}
fi

if ! type -t github_api >/dev/null 2>&1; then
github_api() {
  local method="$1" path="$2" bearer="$3" body="${4:-}"
  local -a data_args=()

  if [ -n "$body" ]; then
    data_args=(--data-binary "$body")
  fi

  printf 'header = "Authorization: Bearer %s"\n' "$bearer" | curl -sS --config - \
    --connect-timeout 10 \
    --max-time 30 \
    -X "$method" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    ${data_args[@]+"${data_args[@]}"} \
    -w '\n%{http_code}' \
    "https://api.github.com${path}"
}
fi

if ! type -t github_api_status >/dev/null 2>&1; then
github_api_status() {
  printf '%s\n' "$1" | tail -n 1
}
fi

if ! type -t github_api_body >/dev/null 2>&1; then
github_api_body() {
  printf '%s\n' "$1" | sed '$d'
}
fi

if ! type -t github_api_message >/dev/null 2>&1; then
github_api_message() {
  github_api_body "$1" | jq -r '.message // empty' 2>/dev/null || true
}
fi

if ! type -t github_app_private_key >/dev/null 2>&1; then
github_app_private_key() {
  local entry="$1" key_file="$2" key_path key_param

  key_path=$(github_app_field "$entry" private-key)
  key_param=$(github_app_field "$entry" private-key-ssm-parameter)

  if [ -n "$key_path" ]; then
    [ -r "$key_path" ] || die "the GitHub App private key ${key_path} is not readable from the agent"
    cp "$key_path" "$key_file" || die "could not copy the GitHub App private key ${key_path}"
    return 0
  fi

  if [ -n "$key_param" ]; then
    env -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY -u AWS_SESSION_TOKEN \
      aws ssm get-parameter \
        --name "$key_param" \
        --with-decryption \
        --query 'Parameter.Value' \
        --output text > "$key_file" \
      || die "could not read the GitHub App private key from SSM parameter ${key_param} with the agent's own credentials"
    return 0
  fi

  die "the GitHub App entry has neither private-key nor private-key-ssm-parameter"
}
fi

if ! type -t mint_github_token >/dev/null 2>&1; then
mint_github_token() (
  set -euo pipefail
  owner="${1%%/*}"
  repo="${1#*/}"
  permission="$2"

  entry=$(github_app_entry "$owner")
  app_id=$(github_app_field "$entry" app-id)
  installation_id=$(github_app_field "$entry" installation-id)

  if [ -z "$app_id" ]; then
    die "the GitHub App entry for '${owner}' in NP_GITHUB_APPS has no app-id"
  fi

  key_dir=$(mktemp -d)
  trap 'rm -rf "$key_dir"' EXIT
  chmod 700 "$key_dir"
  key_file="$key_dir/key.pem"
  github_app_private_key "$entry" "$key_file"

  require_step
  now=$(date +%s)
  jwt=$(step crypto jwt sign \
    --key "$key_file" \
    --iss "$app_id" \
    --alg RS256 \
    --subtle \
    --iat "$((now - 60))" \
    --nbf "$((now - 60))" \
    --exp "$((now + 540))" </dev/null) \
    || die "could not sign a JWT for GitHub App ${app_id}"

  if [ -z "$installation_id" ]; then
    response=$(github_api GET "/repos/${owner}/${repo}/installation" "$jwt") \
      || die "could not reach the GitHub API to find the installation of App ${app_id} on ${owner}/${repo}"
    case "$(github_api_status "$response")" in
      200) installation_id=$(github_api_body "$response" | jq -r '.id // empty') ;;
      404) die "repository ${owner}/${repo} does not exist, or GitHub App ${app_id} is not installed on it" ;;
      *)   die "GitHub refused the installation lookup for ${owner}/${repo} ($(github_api_status "$response")): $(github_api_message "$response")" ;;
    esac
  fi

  body=$(jq -nc --arg repo "$repo" --arg permission "$permission" \
    '{repositories: [$repo], permissions: {contents: $permission}}')
  response=$(github_api POST "/app/installations/${installation_id}/access_tokens" "$jwt" "$body") \
    || die "could not reach the GitHub API to mint a token for ${owner}/${repo}"

  case "$(github_api_status "$response")" in
    201) ;;
    404|422) die "GitHub refused a contents:${permission} token for ${owner}/${repo}: $(github_api_message "$response"). Check that the repository exists and that GitHub App ${app_id} is installed on it with Contents: ${permission}" ;;
    *)       die "GitHub refused a contents:${permission} token for ${owner}/${repo} ($(github_api_status "$response")): $(github_api_message "$response")" ;;
  esac

  token=$(github_api_body "$response" | jq -r '.token // empty')
  if [ -z "$token" ]; then
    die "GitHub returned no token for ${owner}/${repo}"
  fi

  echo "$token"
)
fi

if ! type -t git_with_token >/dev/null 2>&1; then
git_with_token() {
  local token="$1" header
  shift

  header="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$token" | base64 | tr -d '\n')"

  GIT_TERMINAL_PROMPT=0 \
  GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0="http.https://github.com/.extraheader" \
  GIT_CONFIG_VALUE_0="$header" \
    git "$@"
}
fi
