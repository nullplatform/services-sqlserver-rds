#!/bin/bash
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  bash "${BASH_SOURCE[0]}" || exit 1
  return 0
fi
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"
source "$SCRIPT_DIR/migrations_lib"

load_migration_parameters

export LC_ALL=C
SOURCE_DIR="${MIGRATIONS_DIR}/repo/${SCRIPTS_PATH}"
STAGE_DIR="${MIGRATIONS_DIR}/stage"
mkdir -p "$STAGE_DIR"
: > "${MIGRATIONS_DIR}/scripts.txt"
: > "${MIGRATIONS_DIR}/pending.txt"

for file in "$SOURCE_DIR"/*.sql; do
  [ -f "$file" ] || continue
  name=$(basename "$file")
  case "$name" in
    changelog*) continue ;;
  esac
  echo "$name" >> "${MIGRATIONS_DIR}/scripts.txt"
done

if ! has_migration_scripts; then
  echo "No scripts in ${SCRIPTS_PATH} at ${MIGRATIONS_BRANCH} ($(migrations_commit_label)): nothing to apply."
  exit 0
fi

echo "Scripts in ${SCRIPTS_PATH}:"
sed 's/^/  - /' "${MIGRATIONS_DIR}/scripts.txt"

INVALID=$(grep -Ev '^[0-9]{2}_[A-Za-z0-9._-]+\.sql$' "${MIGRATIONS_DIR}/scripts.txt" || true)
if [ -n "$INVALID" ]; then
  die "script names must look like NN_description.sql (two digits, underscore, letters, digits, '.', '_' or '-'): $(echo "$INVALID" | paste -sd, -)"
fi

VIOLATIONS=""
while IFS= read -r name; do
  found=$(forbidden_commands "${SOURCE_DIR}/${name}" "$ENVIRONMENT_DIRECTORY") \
    || die "could not read ${name} to check it for forbidden commands"
  if [ -n "$found" ]; then
    VIOLATIONS="${VIOLATIONS}  - ${name}: ${found}"$'\n'
  fi
done < "${MIGRATIONS_DIR}/scripts.txt"

if [ -n "$VIOLATIONS" ]; then
  echo "Forbidden commands found (GRANT CONNECT is blocked everywhere; DROP, TRUNCATE and SELECT * outside dev):" >&2
  printf '%s' "$VIOLATIONS" >&2
  die "remove the forbidden commands from the scripts above, then run migrations again"
fi

while IFS= read -r name; do
  if has_bom "${SOURCE_DIR}/${name}"; then
    echo "WARNING: ${name} starts with a UTF-8 BOM; it is removed before running. Save the file without BOM."
  fi
  copy_without_bom "${SOURCE_DIR}/${name}" "${STAGE_DIR}/${name}" \
    || die "could not stage ${name}"
done < "${MIGRATIONS_DIR}/scripts.txt"

RUN_ON_CHANGE=false
if [ "$ENVIRONMENT_DIRECTORY" = "dev" ]; then
  RUN_ON_CHANGE=true
fi

jq -R -s \
  --arg logical "${SCRIPTS_PATH}/changelog" \
  --argjson run_on_change "$RUN_ON_CHANGE" \
  '{
    databaseChangeLog: [
      split("\n")[] | select(length > 0) | {
        changeSet: {
          id: sub("\\.sql$"; ""),
          author: "nullplatform",
          logicalFilePath: $logical,
          runOnChange: $run_on_change,
          changes: [
            {
              sqlFile: {
                path: "stage/\(.)",
                relativeToChangelogFile: true,
                splitStatements: true,
                endDelimiter: "\\nGO",
                stripComments: false,
                encoding: "UTF-8"
              }
            }
          ]
        }
      }
    ]
  }' "${MIGRATIONS_DIR}/scripts.txt" > "${MIGRATIONS_DIR}/changelog.json"

COUNT=$(jq '.databaseChangeLog | length' "${MIGRATIONS_DIR}/changelog.json")
echo "Changelog generated with ${COUNT} changeset(s) (runOnChange ${RUN_ON_CHANGE})."
