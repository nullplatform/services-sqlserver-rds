#!/bin/bash
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  bash "${BASH_SOURCE[0]}" || exit 1
  return 0
fi
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"
source "$SCRIPT_DIR/migrations_lib"

load_migration_parameters

if ! has_migration_scripts; then
  echo "Nothing to run on ${DB_NAME}."
  exit 0
fi

require_liquibase

CREDENTIALS=$(aws secretsmanager get-secret-value \
  --secret-id "$MIGRATOR_SECRET_ARN" \
  --query 'SecretString' \
  --output text) || die "could not read the migrations user credentials from ${MIGRATOR_SECRET_ARN}"

MIGRATOR_USER=$(echo "$CREDENTIALS" | jq -r '.username // empty')
MIGRATOR_PASSWORD=$(echo "$CREDENTIALS" | jq -r '.password // empty')

if [ -z "$MIGRATOR_USER" ] || [ -z "$MIGRATOR_PASSWORD" ]; then
  die "the migrations user secret ${MIGRATOR_SECRET_ARN} has no username or password"
fi

JDBC_URL="jdbc:sqlserver://${SERVER_HOSTNAME}:${SERVER_PORT};databaseName=${DB_NAME};encrypt=true;trustServerCertificate=true;loginTimeout=30"

liquibase() {
  env -i \
    PATH="$PATH" \
    HOME="$HOME" \
    JAVA_HOME="$JAVA_HOME" \
    LIQUIBASE_COMMAND_USERNAME="$MIGRATOR_USER" \
    LIQUIBASE_COMMAND_PASSWORD="$MIGRATOR_PASSWORD" \
    LIQUIBASE_ANALYTICS_ENABLED=false \
    LIQUIBASE_SHOW_BANNER=false \
    "$MIGRATIONS_LIQUIBASE_BIN" \
      --classpath="$MSSQL_JDBC_JAR" \
      --search-path="$MIGRATIONS_DIR" \
      --changelog-file=changelog.json \
      --url="$JDBC_URL" \
      "$@"
}

echo "Validating the changelog against ${DB_NAME} on ${SERVER_HOSTNAME} as ${MIGRATOR_USER}..."
liquibase validate || die "liquibase validate failed: see the error above"

STATUS=$(liquibase status --verbose) || die "liquibase status failed: see the error above"
pending_changesets "$STATUS" \
  || die "could not read the pending changesets from liquibase status: ${STATUS}"

if ! [ -s "${MIGRATIONS_DIR}/pending.txt" ]; then
  echo "Nothing to apply: every script in ${SCRIPTS_PATH} already ran on ${DB_NAME}."
  exit 0
fi

echo "Scripts not yet applied on ${DB_NAME}:"
sed 's/^/  - /' "${MIGRATIONS_DIR}/pending.txt"

echo "SQL that the update runs:"
liquibase update-sql --output-file="${MIGRATIONS_DIR}/preview.sql" \
  || die "liquibase update-sql failed: see the error above"
cat "${MIGRATIONS_DIR}/preview.sql"

if [ "$MIGRATIONS_MODE" = "apply" ]; then
  echo "Applying the changesets..."
  liquibase update \
    || die "liquibase update failed: changesets that ran before the failure are recorded in DATABASECHANGELOG and are skipped on retry"
  echo "Changesets applied."
else
  echo "Preview mode: nothing was applied."
fi
