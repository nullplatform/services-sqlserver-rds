#!/bin/bash

if ! type -t die >/dev/null 2>&1; then
die() {
  echo "ERROR: $*" >&2
  exit 1
}
fi

if ! type -t yaml_value >/dev/null 2>&1; then
yaml_value() {
  local key="$1" default="$2" file="$3"
  local val
  val=$(grep "^${key}:" "$file" 2>/dev/null | sed 's/^[^:]*: *//;s/^"//;s/"$//' | head -1)
  echo "${val:-$default}"
}
fi

if ! type -t validate_identifier >/dev/null 2>&1; then
validate_identifier() {
  local label="$1" value="$2"

  if [ -z "$value" ]; then
    die "${label} is empty"
  fi

  if ! printf '%s' "$value" | grep -Eq '^[A-Za-z][A-Za-z0-9_]{0,63}$'; then
    die "${label} '${value}' is not a valid SQL Server identifier (letter followed by up to 63 letters, digits or underscores)"
  fi
}
fi

if ! type -t validate_password >/dev/null 2>&1; then
validate_password() {
  local value="$1"

  if [ -z "$value" ]; then
    die "generated password is empty"
  fi

  if ! printf '%s' "$value" | grep -Eq '^[A-Za-z0-9]{16,128}$'; then
    die "generated password contains characters that are unsafe to substitute into T-SQL; db_setup must keep random_password.special = false"
  fi
}
fi

if ! type -t fetch_master_credentials >/dev/null 2>&1; then
fetch_master_credentials() {
  local secret_arn="$1"
  local creds

  if [ -z "$secret_arn" ]; then
    die "master secret ARN is empty — cannot reach the SQL Server instance"
  fi

  creds=$(aws secretsmanager get-secret-value \
    --secret-id "$secret_arn" \
    --query 'SecretString' \
    --output text) || die "could not read master credentials from ${secret_arn}"

  MASTER_USER=$(echo "$creds" | jq -r '.username')
  SQLCMDPASSWORD=$(echo "$creds" | jq -r '.password')
  export MASTER_USER SQLCMDPASSWORD

  if [ -z "$MASTER_USER" ] || [ "$MASTER_USER" = "null" ]; then
    die "master secret ${secret_arn} has no username field"
  fi
}
fi

SQLCMD_VERSION="1.10.0"

if ! type -t require_sqlcmd >/dev/null 2>&1; then
require_sqlcmd() {
  local tool="github:microsoft/go-sqlcmd@${SQLCMD_VERSION}"
  local bin_dir

  if command -v sqlcmd >/dev/null 2>&1; then
    return 0
  fi

  command -v mise >/dev/null 2>&1 \
    || die "sqlcmd not found in PATH and mise is not available to install go-sqlcmd"

  echo "Installing go-sqlcmd v${SQLCMD_VERSION} with mise..."
  mise install "$tool" >&2 || die "could not install go-sqlcmd v${SQLCMD_VERSION} with mise"

  bin_dir=$(mise bin-paths "$tool") || die "mise installed go-sqlcmd but did not report its bin path"
  export PATH="${bin_dir}:$PATH"

  command -v sqlcmd >/dev/null 2>&1 \
    || die "go-sqlcmd was installed with mise but sqlcmd is still not in PATH"
}
fi

if [ -z "${SQLCMD_CONNECT_FLAGS:-}" ]; then
  SQLCMD_CONNECT_FLAGS_DEFAULT="-b --encrypt-connection true --trust-server-certificate"
  SQLCMD_CONNECT_FLAGS=$(yaml_value "sqlcmd_connect_flags" "$SQLCMD_CONNECT_FLAGS_DEFAULT" "${VALUES:-}")
  export SQLCMD_CONNECT_FLAGS
fi

if ! type -t sqlcmd_exec >/dev/null 2>&1; then
sqlcmd_exec() {
  local database="$1" sql_file="$2"
  shift 2

  require_sqlcmd

  if [ ! -f "$sql_file" ]; then
    die "SQL file not found: ${sql_file}"
  fi

  # shellcheck disable=SC2086
  sqlcmd \
    -S "tcp:${DB_HOST},${DB_PORT}" \
    -U "${MASTER_USER}" \
    -d "${database}" \
    $SQLCMD_CONNECT_FLAGS \
    -i "$sql_file" \
    "$@"
}
fi

if ! type -t access_level_flags >/dev/null 2>&1; then
access_level_flags() {
  case "$1" in
    read)       echo "1 0 0" ;;
    write)      echo "0 1 0" ;;
    read-write) echo "1 1 1" ;;
    *)          die "unknown access level '$1' (expected read, write or read-write)" ;;
  esac
}
fi

if ! type -t instance_name_for >/dev/null 2>&1; then
instance_name_for() {
  local slug="$1" service_id="$2" label max_label

  label=$(echo "$slug" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
  [ -n "$label" ] || die "cannot name the resources: the service has no name"

  if [[ ! "$label" =~ ^[a-z] ]]; then
    label="db-${label}"
  fi

  max_label=$((63 - 1 - ${#service_id}))
  label="${label:0:$max_label}"
  while [[ "$label" == *- ]]; do
    label="${label%-}"
  done

  echo "${label}-${service_id}"
}
fi

if ! type -t read_db_setup_state >/dev/null 2>&1; then
read_db_setup_state() (
  local key="${TFSTATE_KEY_PREFIX}db_setup.tfstate" rc=0

  state_file=$(mktemp)
  err_file=$(mktemp)
  trap 'rm -f "$state_file" "$err_file"' EXIT
  aws s3api get-object \
    --bucket "$TFSTATE_BUCKET" \
    --key "$key" \
    --region "$REGION" \
    "$state_file" >/dev/null 2>"$err_file" || rc=$?

  if [ "$rc" -eq 0 ]; then
    cat "$state_file"
  elif grep -q "NoSuchKey" "$err_file"; then
    rc=2
  else
    cat "$err_file" >&2
    rc=1
  fi

  exit "$rc"
)
fi

if ! type -t context_dimensions >/dev/null 2>&1; then
context_dimensions() {
  echo "$1" | jq -r '
    if (.service.dimensions | type) == "object" and ((.service.dimensions | length) > 0)
    then [ .service.dimensions | to_entries[] | "\(.key):\(.value)" ] | join(",")
    else empty end'
}
fi

if ! type -t provider_attributes >/dev/null 2>&1; then
provider_attributes() {
  local category="$1" nrn="$2" dimensions="$3"
  np provider list \
    --nrn "$nrn" \
    --categories "$category" \
    ${dimensions:+--dimensions "$dimensions"} \
    --format json \
    | jq -c '(.results // [])[0].attributes // {}'
}
fi
