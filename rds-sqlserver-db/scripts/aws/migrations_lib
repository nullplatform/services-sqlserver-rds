#!/bin/bash

MIGRATIONS_BRANCH="main"
LIQUIBASE_VERSION="5.0.2"
JAVA_GLIBC_VERSION="zulu-21.54.109.0"
JAVA_MUSL_VERSION="zulu-musl-21.54.109.0"
MSSQL_JDBC_VERSION="13.6.2.jre11"
MSSQL_JDBC_SHA256="5fbc0a70fe4d1d563d431a41b23f493d68807571f0bb49db0bb1737e83e9161f"

if ! type -t migration_parameter >/dev/null 2>&1; then
migration_parameter() {
  echo "$CONTEXT" | jq -r --arg name "$1" '.parameters[$name] // "" | tostring'
}
fi

if ! type -t reject_symlinks >/dev/null 2>&1; then
reject_symlinks() {
  local dir="$1" label="$2" links

  links=$(cd "$dir" && find . -path ./.git -prune -o -type l -print) \
    || die "could not inspect ${label} for symbolic links"
  if [ -n "$links" ]; then
    die "${label} contains symbolic links, which are not allowed: $(echo "$links" | sed 's|^\./||' | paste -sd, -)"
  fi
}
fi

if ! type -t validate_directory_name >/dev/null 2>&1; then
validate_directory_name() {
  local label="$1" value="$2"

  if ! printf '%s' "$value" | grep -Eq '^[A-Za-z0-9_-]+$'; then
    die "${label} '${value}' must be a single directory name (letters, digits, '_' or '-')"
  fi
}
fi

if ! type -t resolve_sigla >/dev/null 2>&1; then
resolve_sigla() {
  local slug sigla

  slug=$(jq -r '[.namespace.slug?, .tags.namespace?] | map(select(type == "string" and . != "")) | first // empty' <<< "$1")

  if [ -z "$slug" ]; then
    die "cannot resolve the application's sigla: the context has neither namespace.slug nor tags.namespace"
  fi

  sigla=$(printf '%s' "${slug%%-*}" | tr '[:lower:]' '[:upper:]')

  if [[ ! "$sigla" =~ ^[A-Z0-9]([A-Z0-9_.]{0,61}[A-Z0-9])?$ ]]; then
    die "cannot use '${sigla}' (from namespace '${slug}') as the application's sigla"
  fi

  printf '%s' "$sigla"
}
fi

if ! type -t migrations_github_org >/dev/null 2>&1; then
migrations_github_org() {
  local org orgs count

  org=$(yaml_value "migrations_github_org" "" "${VALUES:-}")
  if [ -n "$org" ]; then
    echo "$org"
    return 0
  fi

  orgs=$(tr ';' '\n' <<< "${NP_GITHUB_APPS:-}" | awk -F, '{ for (i = 1; i <= NF; i++) if ($i ~ /^org=/) print substr($i, 5) }')
  count=$(grep -c . <<< "$orgs" || true)

  if [ "$count" -ne 1 ]; then
    die "cannot tell which GitHub org holds the <sigla>-databases repositories: set migrations_github_org in values.yaml (the agent has GitHub Apps for: $(paste -sd, - <<< "$orgs"))"
  fi

  echo "$orgs"
}
fi

if ! type -t migrations_environment >/dev/null 2>&1; then
migrations_environment() {
  local environment

  environment=$(jq -r '.service.dimensions.environment // empty' <<< "$1")
  if [ -z "$environment" ]; then
    die "the service has no environment dimension, which names the directory of the repository to read"
  fi

  validate_directory_name "environment dimension" "$environment"
  echo "$environment"
}
fi

if ! type -t load_migration_parameters >/dev/null 2>&1; then
load_migration_parameters() {
  DATABASE_DIRECTORY=$(migration_parameter database_directory)
  MIGRATIONS_MODE=$(migration_parameter mode)

  SIGLA=$(resolve_sigla "$CONTEXT")
  ENVIRONMENT_DIRECTORY=$(migrations_environment "$CONTEXT")
  GITHUB_ORG=$(migrations_github_org)
  GITHUB_REPOSITORY="${GITHUB_ORG}/$(printf '%s-databases' "$SIGLA" | tr '[:upper:]' '[:lower:]')"

  DATABASE_DIRECTORY="${DATABASE_DIRECTORY:-${DB_NAME:-}}"
  validate_directory_name "database_directory" "$DATABASE_DIRECTORY"

  case "$MIGRATIONS_MODE" in
    preview|apply) ;;
    *) die "mode '${MIGRATIONS_MODE}' is not valid (expected preview or apply)" ;;
  esac

  if [ -z "${OUTPUT_DIR:-}" ]; then
    die "OUTPUT_DIR is not set. Expected to be exported by build_context."
  fi

  MIGRATIONS_DIR="${OUTPUT_DIR}/migrations"
  SCRIPTS_PATH="${ENVIRONMENT_DIRECTORY}/${DATABASE_DIRECTORY}"

  export MIGRATIONS_BRANCH ENVIRONMENT_DIRECTORY DATABASE_DIRECTORY MIGRATIONS_MODE GITHUB_REPOSITORY MIGRATIONS_DIR SCRIPTS_PATH SIGLA
}
fi

if ! type -t migrations_commit_label >/dev/null 2>&1; then
migrations_commit_label() {
  local commit

  commit=$(cat "${MIGRATIONS_DIR}/commit") || return 1
  printf '%s' "${commit:0:12}"
}
fi

if ! type -t strip_sql_comments >/dev/null 2>&1; then
strip_sql_comments() {
  awk '
    BEGIN { quote = "\047" }
    {
      out = ""
      n = length($0)
      i = 1
      while (i <= n) {
        c = substr($0, i, 1)
        pair = substr($0, i, 2)
        if (in_block) {
          if (pair == "*/") { in_block = 0; out = out " "; i += 2 } else { i++ }
          continue
        }
        if (closer != "") {
          if (pair == closer closer) { out = out pair; i += 2; continue }
          if (c == closer) { closer = "" }
          out = out c
          i++
          continue
        }
        if (pair == "--") { break }
        if (pair == "/*") { in_block = 1; i += 2; continue }
        if (c == quote) { closer = quote }
        else if (c == "[") { closer = "]" }
        else if (c == "\"") { closer = "\"" }
        out = out c
        i++
      }
      print out
    }
  ' "$1"
}
fi

if ! type -t forbidden_commands >/dev/null 2>&1; then
forbidden_commands() {
  local file="$1" environment="$2" content found="" keyword

  content=$(strip_sql_comments "$file" | tr '\n' ' ' | tr '[:lower:]' '[:upper:]') || return 1

  if grep -Eq '(^|[^A-Z0-9_])GRANT[^;]*[^A-Z0-9_]CONNECT([^A-Z0-9_]|$)' <<< "$content"; then
    found="GRANT CONNECT"
  fi

  if [ "$environment" != "dev" ]; then
    for keyword in DROP TRUNCATE; do
      if grep -Eq "(^|[^A-Z0-9_])${keyword}[[:space:]]" <<< "$content"; then
        found="${found:+${found}, }${keyword}"
      fi
    done
    if grep -Eq '(^|[^A-Z0-9_])SELECT[[:space:]]+\*' <<< "$content"; then
      found="${found:+${found}, }SELECT *"
    fi
  fi

  echo "$found"
}
fi

if ! type -t has_bom >/dev/null 2>&1; then
has_bom() {
  [ "$(head -c 3 "$1")" = "$(printf '\357\273\277')" ]
}
fi

if ! type -t copy_without_bom >/dev/null 2>&1; then
copy_without_bom() {
  local source="$1" target="$2"

  if has_bom "$source"; then
    tail -c +4 "$source" > "$target"
  else
    cp "$source" "$target"
  fi
}
fi

if ! type -t is_musl >/dev/null 2>&1; then
is_musl() {
  local loader

  for loader in /lib/ld-musl-*; do
    [ -e "$loader" ] && return 0
  done
  return 1
}
fi

if ! type -t sha256_of >/dev/null 2>&1; then
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  else
    shasum -a 256 "$1" | cut -d' ' -f1
  fi
}
fi

if ! type -t require_mssql_jdbc >/dev/null 2>&1; then
require_mssql_jdbc() {
  local cache_dir jar url

  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/np-rds-sqlserver"
  jar="${cache_dir}/mssql-jdbc-${MSSQL_JDBC_VERSION}.jar"
  url="https://repo1.maven.org/maven2/com/microsoft/sqlserver/mssql-jdbc/${MSSQL_JDBC_VERSION}/mssql-jdbc-${MSSQL_JDBC_VERSION}.jar"

  mkdir -p "$cache_dir" || die "could not create ${cache_dir}"

  if [ ! -f "$jar" ] || [ "$(sha256_of "$jar")" != "$MSSQL_JDBC_SHA256" ]; then
    echo "Downloading mssql-jdbc ${MSSQL_JDBC_VERSION}..." >&2
    curl -sSfL --connect-timeout 10 --max-time 120 -o "${jar}.part" "$url" \
      || die "could not download mssql-jdbc ${MSSQL_JDBC_VERSION} from Maven Central"
    if [ "$(sha256_of "${jar}.part")" != "$MSSQL_JDBC_SHA256" ]; then
      rm -f "${jar}.part"
      die "mssql-jdbc ${MSSQL_JDBC_VERSION} downloaded from Maven Central does not match its pinned sha256"
    fi
    mv "${jar}.part" "$jar" || die "could not store mssql-jdbc in ${cache_dir}"
  fi

  echo "$jar"
}
fi

if ! type -t require_liquibase >/dev/null 2>&1; then
require_liquibase() {
  local java_version="$JAVA_GLIBC_VERSION" liquibase_bin_dir

  if is_musl; then
    java_version="$JAVA_MUSL_VERSION"
  fi

  require_mise_tool "java@${java_version}"
  JAVA_HOME=$(mise where "java@${java_version}") \
    || die "mise installed java@${java_version} but did not report where"
  require_mise_tool "liquibase@${LIQUIBASE_VERSION}"
  liquibase_bin_dir=$(mise bin-paths "liquibase@${LIQUIBASE_VERSION}") \
    || die "mise installed liquibase@${LIQUIBASE_VERSION} but did not report its bin path"
  MIGRATIONS_LIQUIBASE_BIN="${liquibase_bin_dir}/liquibase"
  MSSQL_JDBC_JAR=$(require_mssql_jdbc)

  [ -x "${JAVA_HOME}/bin/java" ] || die "java ${java_version} was installed with mise but ${JAVA_HOME}/bin/java is missing"
  [ -x "$MIGRATIONS_LIQUIBASE_BIN" ] || die "liquibase ${LIQUIBASE_VERSION} was installed with mise but ${MIGRATIONS_LIQUIBASE_BIN} is missing"

  export JAVA_HOME MIGRATIONS_LIQUIBASE_BIN MSSQL_JDBC_JAR
}
fi
