#!/bin/bash
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  bash "${BASH_SOURCE[0]}" || exit 1
  return 0
fi
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"
source "$SCRIPT_DIR/migrations_lib"

load_migration_parameters

COMMIT=$(cat "${MIGRATIONS_DIR}/commit")
HISTORY_COMMIT=""
if [ -f "${MIGRATIONS_DIR}/history_commit" ]; then
  HISTORY_COMMIT=$(cat "${MIGRATIONS_DIR}/history_commit")
fi

RESULTS=$(jq -nc \
  --arg mode "$MIGRATIONS_MODE" \
  --arg commit "$COMMIT" \
  --arg history_commit "$HISTORY_COMMIT" \
  --rawfile scripts "${MIGRATIONS_DIR}/pending.txt" \
  '{
    mode: $mode,
    commit: $commit,
    scripts: ($scripts | split("\n") | map(select(length > 0))),
    history_commit: $history_commit
  }')

np service action update --results "$RESULTS"

rm -rf "$MIGRATIONS_DIR"
echo "Migrations ${MIGRATIONS_MODE} finished for ${SCRIPTS_PATH} at ${MIGRATIONS_BRANCH} ${COMMIT:0:12}."
