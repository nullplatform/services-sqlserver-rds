#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"

read_tofu_password() {
  local name="$1" value

  value=$(tofu output -raw "$name" 2>/dev/null) \
    || die "could not read ${name} from the db_setup module outputs"

  if [ -z "$value" ]; then
    die "${name} output is empty — did the db_setup module apply successfully?"
  fi

  validate_password "$value"
  echo "$value"
}

provision_login() {
  local user="$1" password="$2"

  sqlcmd_exec master "$SERVICE_PATH/sql/create_database_and_login.sql" \
    -v DbName="$DB_NAME" \
    -v DbUser="$user" \
    -v DbPassword="$password"

  sqlcmd_exec "$DB_NAME" "$SERVICE_PATH/sql/create_user.sql" \
    -v DbUser="$user"
}

if [ "${SETUP_SKIPPED:-}" = "true" ]; then
  echo "Skipping database provisioning — setup was not completed."
  exit 0
fi

validate_identifier "database name" "${DB_NAME:-}"
validate_identifier "database username" "${DB_USERNAME:-}"
validate_identifier "migrations username" "${MIGRATOR_USERNAME:-}"

cd "$OUTPUT_DIR"

DB_PASSWORD=$(read_tofu_password db_password)
MIGRATOR_PASSWORD=$(read_tofu_password migrator_password)

fetch_master_credentials "$MASTER_SECRET_ARN"

echo "Provisioning database ${DB_NAME} and login ${DB_USERNAME} on ${DB_HOST}..."
provision_login "$DB_USERNAME" "$DB_PASSWORD"

echo "Provisioning migrations login ${MIGRATOR_USERNAME} as db_owner of ${DB_NAME}..."
provision_login "$MIGRATOR_USERNAME" "$MIGRATOR_PASSWORD"

sqlcmd_exec "$DB_NAME" "$SERVICE_PATH/sql/add_db_owner.sql" \
  -v DbUser="$MIGRATOR_USERNAME"

echo "Database provisioning complete."
