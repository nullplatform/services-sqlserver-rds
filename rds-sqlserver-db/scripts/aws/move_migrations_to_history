#!/bin/bash
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  bash "${BASH_SOURCE[0]}" || exit 1
  return 0
fi
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"
source "$SCRIPT_DIR/github_app"
source "$SCRIPT_DIR/migrations_lib"

MOVE_ATTEMPTS=3

commit_history_move() {
  local token="$1" branch="$2" work_dir="$3" timestamp commit_label name base target count

  timestamp=$(cat "${MIGRATIONS_DIR}/timestamp") || return 1
  commit_label=$(migrations_commit_label) || return 1

  rm -rf "$work_dir"
  git_with_token "$token" clone --quiet --depth 1 --branch "$branch" \
    "https://github.com/${GITHUB_REPOSITORY}.git" "$work_dir" || return 1

  reject_symlinks "$work_dir" "${GITHUB_REPOSITORY}@${branch}"
  mkdir -p "${work_dir}/${SCRIPTS_PATH}/history" || return 1

  while IFS= read -r name; do
    base="${name%.sql}"
    target="${SCRIPTS_PATH}/history/${base}_${commit_label}_${timestamp}.sql"
    cp "${MIGRATIONS_DIR}/repo/${SCRIPTS_PATH}/${name}" "${work_dir}/${target}" || return 1
    git -C "$work_dir" add -- "$target" || return 1
    git -C "$work_dir" rm --quiet --ignore-unmatch -- "${SCRIPTS_PATH}/${name}" || return 1
  done < "${MIGRATIONS_DIR}/pending.txt"

  if git -C "$work_dir" diff --cached --quiet; then
    echo "The scripts are already in history on ${branch}."
    git -C "$work_dir" rev-parse HEAD > "${MIGRATIONS_DIR}/history_commit"
    return
  fi

  count=$(wc -l < "${MIGRATIONS_DIR}/pending.txt" | tr -d ' ')
  git -C "$work_dir" \
    -c user.name="nullplatform migrations" \
    -c user.email="migrations@nullplatform.com" \
    commit --quiet -m "chore(migrations): move ${count} script(s) of ${SCRIPTS_PATH} to history after ${commit_label}" \
    || return 1

  git_with_token "$token" -C "$work_dir" push --quiet origin "HEAD:refs/heads/${branch}" || return 1

  git -C "$work_dir" rev-parse HEAD > "${MIGRATIONS_DIR}/history_commit"
}

fail_with_pending_scripts() {
  echo "These scripts ran on ${DB_NAME} but are still pending in ${SCRIPTS_PATH}:" >&2
  sed 's/^/  - /' "${MIGRATIONS_DIR}/pending.txt" >&2
  die "$1: move them to history by hand before the next run, otherwise a new commit on ${MIGRATIONS_BRANCH} runs them again"
}

move_to_history() {
  local token branch attempt

  if [ "$MIGRATIONS_MODE" != "apply" ]; then
    echo "Preview mode: nothing to move to history."
    return 0
  fi

  branch="$MIGRATIONS_BRANCH"
  token=$(mint_github_token "$GITHUB_REPOSITORY" write) \
    || fail_with_pending_scripts "could not get a write token for ${GITHUB_REPOSITORY}"

  for attempt in $(seq 1 "$MOVE_ATTEMPTS"); do
    echo "Moving the executed scripts to ${SCRIPTS_PATH}/history on ${branch} (attempt ${attempt}/${MOVE_ATTEMPTS})..."
    if commit_history_move "$token" "$branch" "${MIGRATIONS_DIR}/history-repo"; then
      echo "Moved to history in commit $(cat "${MIGRATIONS_DIR}/history_commit")."
      return 0
    fi
    if [ "$attempt" -lt "$MOVE_ATTEMPTS" ]; then
      sleep "$attempt"
    fi
  done

  fail_with_pending_scripts "could not push the move to history on ${branch}"
}

load_migration_parameters
move_to_history
