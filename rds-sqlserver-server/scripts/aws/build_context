#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib"

SERVICE_ID=$(echo "$CONTEXT" | jq -r '.service.id')
SERVICE_NAME=$(echo "$CONTEXT" | jq -r '.service.name // ""')
SERVICE_NAME="${SERVICE_NAME:-svc-${SERVICE_ID}}"

INSTANCE_NAME="np-$(echo "$SERVICE_NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-55)"

SERVICE_ATTRS=$(echo "$CONTEXT" | jq -r '(.service.attributes // {}) * (.parameters // {})')

EDITION=$(echo "$SERVICE_ATTRS"           | jq -r '.edition           // "sqlserver-ex"')
WORKLOAD=$(echo "$SERVICE_ATTRS"          | jq -r '.workload          // "development"')
ALLOCATED_STORAGE=$(echo "$SERVICE_ATTRS" | jq -r '.allocated_storage // 20')
SQLSERVER_VERSION=$(echo "$SERVICE_ATTRS" | jq -r '.sqlserver_version // "16.00"')
MULTI_AZ=$(echo "$SERVICE_ATTRS"          | jq -r '.multi_az          // false')
SECRET_KMS_KEY_ID="${RDS_SQL_SERVER_SECRET_KMS_KEY_ID:-}"

validate_edition_constraints "$EDITION" "$ALLOCATED_STORAGE" "$MULTI_AZ"

INSTANCE_CLASS=$(instance_class_for_workload "$EDITION" "$WORKLOAD")

AWS_PROFILE_VAL=$(yaml_value "aws_profile" "" "$VALUES")

if [ -n "${AWS_PROFILE_VAL}" ] && [ -z "${AWS_PROFILE:-}" ]; then
  export AWS_PROFILE="${AWS_PROFILE_VAL}"
fi

ENTITY_NRN=$(echo "$CONTEXT" | jq -r '.entity_nrn // .service.nrn // ""')

if [ -z "$ENTITY_NRN" ]; then
  die "could not read the service NRN from .entity_nrn in context"
fi

DIMENSIONS=$(context_dimensions "$CONTEXT")

echo "Resolving region and VPC for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}"

REGION=$(provider_attributes "cloud-providers" "$ENTITY_NRN" "$DIMENSIONS" | jq -r '.account.region // ""')

if [ -z "$REGION" ]; then
  die "no cloud-providers provider with account.region found for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}"
fi

echo "Using region: ${REGION}"
export REGION

VPC_ID=$(provider_attributes "vpc" "$ENTITY_NRN" "$DIMENSIONS" | jq -r '.vpc.id // ""')

if [ -z "$VPC_ID" ]; then
  die "no vpc provider with vpc.id found for ${ENTITY_NRN}${DIMENSIONS:+ (dimensions: ${DIMENSIONS})}"
fi

echo "Using VPC: ${VPC_ID}"

if [ -z "${RDS_SQL_SERVER_S3_STATE_BUCKET:-}" ]; then
  echo "ERROR: RDS_SQL_SERVER_S3_STATE_BUCKET is not set." >&2
  echo "       Set it on the agent to the name of an existing S3 bucket that holds" >&2
  echo "       the tofu state for every instance of this service." >&2
  exit 1
fi

TFSTATE_BUCKET="$RDS_SQL_SERVER_S3_STATE_BUCKET"
TFSTATE_KEY_PREFIX="services/rds-sqlserver/${SERVICE_ID}/"

if ! aws s3api head-bucket --bucket "$TFSTATE_BUCKET" --region "$REGION" >/dev/null 2>&1; then
  echo "ERROR: the state bucket ${TFSTATE_BUCKET} does not exist or is not reachable from ${REGION}." >&2
  exit 1
fi

echo "Using state bucket: ${TFSTATE_BUCKET} (prefix ${TFSTATE_KEY_PREFIX})"

export TFSTATE_BUCKET TFSTATE_KEY_PREFIX

OUTPUT_DIR="/tmp/np-service-${SERVICE_ID}"
export OUTPUT_DIR
mkdir -p "$OUTPUT_DIR"

export TOFU_MODULE_DIR="$SERVICE_PATH/deployment"

export TOFU_INIT_VARIABLES="-backend-config=bucket=${TFSTATE_BUCKET} -backend-config=key=${TFSTATE_KEY_PREFIX}terraform.tfstate -backend-config=region=${REGION}"

TOFU_VARIABLES="-var=service_id=${SERVICE_ID} -var=instance_name=${INSTANCE_NAME} -var=region=${REGION} -var=vpc_id=${VPC_ID} -var=edition=${EDITION} -var=instance_class=${INSTANCE_CLASS} -var=allocated_storage=${ALLOCATED_STORAGE} -var=sqlserver_version=${SQLSERVER_VERSION} -var=multi_az=${MULTI_AZ}"

if [ -n "$SECRET_KMS_KEY_ID" ]; then
  TOFU_VARIABLES="${TOFU_VARIABLES} -var=secret_kms_key_id=${SECRET_KMS_KEY_ID}"
fi

export TOFU_VARIABLES
